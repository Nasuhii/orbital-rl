<mujoco model="orbital_docking">
  <compiler angle="radian" coordinate="local" meshdir="assets" texturedir="assets"/>
  <option gravity="0 0 0" timestep="0.1" integrator="RK4"/>

  <visual>
    <headlight ambient="0.40 0.42 0.48" diffuse="0.92 0.94 0.98" specular="0.45 0.45 0.50"/>
    <global azimuth="140" elevation="-25" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096" offsamples="4"/>
  </visual>

  <asset>
    <texture type="skybox" file="space_skybox.png"/>
    <texture name="tex_station" type="2d" builtin="checker" rgb1="0.82 0.85 0.90" rgb2="0.74 0.78 0.84" width="256" height="256" mark="edge" markrgb="0.52 0.58 0.66"/>
    <texture name="tex_solar" type="2d" builtin="checker" rgb1="0.05 0.14 0.38" rgb2="0.09 0.24 0.58" width="256" height="256" mark="edge" markrgb="0.55 0.74 0.96"/>
    <texture name="tex_earth" type="2d" file="earth_daymap.png"/>
    <material name="mat_station" texture="tex_station" texrepeat="4 4" specular="0.8" shininess="0.8"/>
    <material name="mat_solar" texture="tex_solar" texrepeat="6 12" specular="0.95" shininess="0.95"/>
    <material name="mat_truss" specular="0.6" shininess="0.6" rgba="0.45 0.50 0.58 1"/>
    <material name="mat_port" specular="0.9" shininess="0.9" emission="0.22" rgba="0.08 0.92 0.52 1"/>
    <material name="mat_chaser" specular="0.75" shininess="0.75" rgba="0.95 0.96 0.99 1"/>
    <material name="mat_chaser_sm" specular="0.7" shininess="0.7" rgba="0.22 0.27 0.36 1"/>
    <material name="mat_earth" texture="tex_earth" specular="0.35" shininess="0.25" emission="0.15"/>
    <material name="mat_earth_atmo" specular="0.4" shininess="0.2" emission="0.25" rgba="0.28 0.68 1.0 0.20"/>
    <material name="mat_crosshair" specular="0.9" shininess="0.9" emission="0.45" rgba="0.98 0.86 0.12 1"/>
  </asset>

  <worldbody>
    <light directional="true" pos="30 40 30" dir="-0.5 -0.6 -0.5" diffuse="1.25 1.25 1.2" specular="0.6 0.6 0.6"/>
    <light directional="true" pos="-20 -30 -20" dir="0.5 0.6 0.5" diffuse="0.35 0.48 0.78" specular="0.15 0.2 0.3"/>

    <!-- Distant Earth Limb & Atmosfer Halesi (İstasyonun altında ve arkasında ufuk çizgisi - Sıfır Fizik Teması) -->
    <geom name="earth_limb" type="sphere" size="92" pos="0 -35 -104" material="mat_earth" contype="0" conaffinity="0"/>
    <geom name="earth_atmo" type="sphere" size="94.5" pos="0 -35 -104" material="mat_earth_atmo" contype="0" conaffinity="0"/>

    <!-- 1. HEDEF UZAY İSTASYONU (TARGET STATION) -->
    <body name="target_station" pos="0 0 0">
      <!-- Ana Modül -->
      <geom name="station_body" type="cylinder" size="1.2 3.0" euler="0 1.5708 0" material="mat_station"/>
      <geom name="station_truss" type="box" size="0.2 0.2 6.0" pos="0 0 0" material="mat_truss"/>
      <geom name="solar_panel_top" type="box" size="1.2 0.05 2.5" pos="0 0 3.8" material="mat_solar"/>
      <geom name="solar_panel_bot" type="box" size="1.2 0.05 2.5" pos="0 0 -3.8" material="mat_solar"/>

      <!-- Kenetlenme Portu (Y=1.6m Hizalanmış İskele) -->
      <geom name="docking_tunnel" type="cylinder" size="0.65 0.3" pos="0 1.3 0" euler="1.5708 0 0" material="mat_truss"/>
      <geom name="docking_port_ring" type="cylinder" size="0.55 0.1" pos="0 1.6 0" euler="1.5708 0 0" material="mat_port"/>
      <site name="docking_port_site" pos="0 1.6 0" size="0.2" rgba="0 1 0 0.9"/>

      <!-- Görsel Hedefleme Artı İşareti (Optical Alignment Crosshair) -->
      <geom name="crosshair_h" type="box" size="0.25 0.01 0.02" pos="0 1.62 0" material="mat_crosshair" contype="0" conaffinity="0"/>
      <geom name="crosshair_v" type="box" size="0.02 0.01 0.25" pos="0 1.62 0" material="mat_crosshair" contype="0" conaffinity="0"/>

      <!-- İstasyon Güvenlik CCTV Kamerası -->
      <camera name="station_cctv" pos="0 2.2 0.35" euler="1.5708 0 0" fovy="60"/>
    </body>

    <!-- 2. KOVALAYICI UZAY ARACI (CHASER SPACECRAFT - CoM Origin: pos 0 0.208 0 hizalanmış) -->
    <body name="chaser" pos="0 25 0">
      <freejoint name="chaser_freejoint"/>
      <!-- Servis Modülü (300 kg) -->
      <geom name="chaser_sm" type="cylinder" size="0.45 0.35" pos="0 0.292 0" euler="1.5708 0 0" material="mat_chaser_sm" mass="300"/>
      <!-- Kapsül Gövdesi (190 kg) -->
      <geom name="chaser_capsule" type="capsule" size="0.4 0.4" pos="0 -0.408 0" euler="1.5708 0 0" material="mat_chaser" mass="190"/>
      <!-- Burun Kenetlenme Probu (10 kg) -->
      <geom name="chaser_probe" type="cylinder" size="0.1 0.25" pos="0 -1.008 0" euler="1.5708 0 0" rgba="0.2 0.9 0.4 1" mass="10"/>
      
      <!-- İtici Merkezi (Tam CoM'de [0,0,0]) -->
      <site name="chaser_center_site" pos="0 0 0" size="0.15" rgba="1 1 0 0.8"/>
      <!-- Prob Ucu Sensörü (Yerel Y = -1.258m) -->
      <site name="chaser_docking_probe" pos="0 -1.258 0" size="0.1" rgba="0.2 1 0.2 1"/>

      <!-- Kovalayıcı Kameraları: FPV Prob Kamerası & Takip (Chase) Kamerası -->
      <camera name="probe_cam" pos="0 -1.3 0" euler="-1.5708 0 0" fovy="65"/>
      <camera name="chase_cam" pos="0 3.6 1.4" euler="-1.35 0 0" fovy="55"/>
    </body>

    <!-- Taktik Yörünge Geniş Açı Kamerası -->
    <camera name="orbital_tactical" pos="10 16 8" mode="targetbody" target="target_station" fovy="50"/>
  </worldbody>

  <actuator>
    <motor name="thrust_x" site="chaser_center_site" gear="1 0 0 0 0 0" ctrlrange="-15 15"/>
    <motor name="thrust_y" site="chaser_center_site" gear="0 1 0 0 0 0" ctrlrange="-15 15"/>
    <motor name="thrust_z" site="chaser_center_site" gear="0 0 1 0 0 0" ctrlrange="-15 15"/>
  </actuator>
</mujoco>
